[Unit]
Description=Kleinanzeigen Watcher (Polling + Telegram-Notifikationen)
Documentation=https://github.com/jonas-seidel/kleinanzeigen
# Netz erst aufwarten lassen; nss-lookup ist im User-Bus nicht garantiert,
# darum nur ein "weiches" After= ohne hartes Requires=.
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/jonas/Claude/kleinanzeigen

# Secrets (TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID) aus .env laden.
EnvironmentFile=/home/jonas/Claude/kleinanzeigen/.env

# Venv-Python direkt aufrufen, kein "source activate" noetig.
ExecStart=/home/jonas/Claude/kleinanzeigen/.venv/bin/python -m kleinanzeigen_watcher run --config /home/jonas/Claude/kleinanzeigen/config.yaml

# SIGTERM, dann nach 20 s SIGKILL — der Loop sollte sauber zwischen Pollzyklen abbrechen.
KillSignal=SIGTERM
TimeoutStopSec=20

# Restart-Policy: bei Crash neu starten, aber Crash-Loops abfangen.
Restart=on-failure
RestartSec=30
StartLimitBurst=3
StartLimitIntervalSec=600

# Logging in das User-Journal: journalctl --user -u kleinanzeigen-watcher
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kleinanzeigen-watcher

# --- Hardening (User-Service-tauglich, keine kernel-only Optionen) ---
NoNewPrivileges=true
PrivateTmp=true
# Komplettes FS read-only mounten; nur das Repo darf SQLite-DB + Logs schreiben.
ProtectSystem=strict
ReadWritePaths=/home/jonas/Claude/kleinanzeigen
# Keine Shell-Rechte auf Geraetedateien noetig.
ProtectControlGroups=true
ProtectKernelModules=true

[Install]
# Default-Target fuer User-Services (vergleichbar mit multi-user.target system-wide).
WantedBy=default.target
